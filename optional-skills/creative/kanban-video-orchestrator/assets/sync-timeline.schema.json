{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/khanashraf6742-boop/hermes-agent/blob/main/optional-skills/creative/kanban-video-orchestrator/assets/sync-timeline.schema.json",
  "title": "Narrated explainer synchronization timeline",
  "description": "Canonical final-audio-derived handoff for aligned speech units, subtitle cues, and visual events.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audio_master", "alignment_units", "captions", "visual_events"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "audio_master": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "duration_s", "sha256", "language"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "duration_s": {"type": "number", "exclusiveMinimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "language": {"type": "string", "minLength": 2}
      }
    },
    "alignment_units": {
      "type": "array",
      "minItems": 1,
      "description": "Use word granularity where supported; otherwise use the finest reliable phrase or sentence boundaries from the final audio.",
      "items": {"$ref": "#/$defs/alignment_unit"}
    },
    "captions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/caption"}
    },
    "visual_events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/visual_event"}
    }
  },
  "$defs": {
    "alignment_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "granularity", "start_s", "end_s", "text", "concept_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "granularity": {"enum": ["word", "phrase", "sentence"]},
        "start_s": {"type": "number", "minimum": 0},
        "end_s": {"type": "number", "exclusiveMinimum": 0},
        "text": {"type": "string", "minLength": 1},
        "concept_id": {"type": "string", "minLength": 1}
      }
    },
    "caption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start_s", "end_s", "text", "alignment_ids", "concept_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "start_s": {"type": "number", "minimum": 0},
        "end_s": {"type": "number", "exclusiveMinimum": 0},
        "text": {"type": "string", "minLength": 1},
        "alignment_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "concept_id": {"type": "string", "minLength": 1}
      }
    },
    "visual_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start_s", "end_s", "kind", "description", "anchor_alignment_ids", "concept_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "start_s": {"type": "number", "minimum": 0},
        "end_s": {"type": "number", "exclusiveMinimum": 0},
        "kind": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "anchor_alignment_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "concept_id": {"type": "string", "minLength": 1},
        "scene_id": {"type": "string"}
      }
    }
  }
}
